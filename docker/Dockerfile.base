# Pinned to a patch release so a rebuild can't silently fall back to a
# cached older JDK: 25.0.5 fixes CVE-2026-91403 (JSSE/TLS). Bump when
# Temurin ships a new 25.0.x.
FROM eclipse-temurin:25.0.5_8-jdk-noble

# Upgrade every OS package (libbrotli1 CVE-2026-111497, ca-certificates
# CVE-2026-111943, curl, openssl, ...), not only the ones we install.
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
